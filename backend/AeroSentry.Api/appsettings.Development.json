{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Media": {
    "HlsBase": "http://localhost:8888",
    "RtspBase": "rtsp://localhost:8554",
    "MtxManageConfig": true,
    "MtxConfigPath": "../../mediamtx/mediamtx.yml"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Face": {
    "BaseUrl": "http://localhost:8020",
    "MatchThreshold": 0.45,
    "MinEnrollFaceWidth": 100,
    "MinPhotoSimilarity": 0.30,
    "SurveillanceDetSize": 960,
    "AuthorizedPolicy": "SkipDrone",
    "MinRecognizeFaceWidth": 60,
    "MinMatchingFrames": 2,
    "RecognitionFrames": 5
  },
  "Ml": {
    "BaseUrl": "http://localhost:8010",
    "Threshold": 0.5
  }
}
